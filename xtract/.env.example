# =============================================================
# Xtract Roof Reports — environment variables
# =============================================================
# The app runs end to end with NONE of these set (demo mode):
# orders skip payment, roofs are synthetic, and the PDF is
# downloadable from the order page instead of emailed.
# Add each integration as you go live.
# =============================================================

# Public URL of this site (used in Stripe redirects and email links)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ---- Payments: Stripe Checkout ----
# Dashboard > Developers > API keys
STRIPE_SECRET_KEY=
# Dashboard > Developers > Webhooks > add endpoint
#   URL:    https://YOUR-DOMAIN/api/webhooks/stripe
#   Events: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=

# ---- Measurements: Google Maps Platform ----
# One key with these APIs enabled: Geocoding API, Solar API,
# Maps Static API (Static is only used for the Claims Pro aerial page).
GOOGLE_MAPS_API_KEY=

# ---- Delivery: any SMTP provider ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Xtract Roof Reports
# Optional: copy every delivered report to this address
XTRACT_ORDERS_BCC=
# Where "needs review" / failure alerts go
XTRACT_OPS_EMAIL=

# ---- Operations ----
# Enables /admin?key=... (order list + re-run button). Use a long random string.
XTRACT_ADMIN_KEY=
# Where orders.json and generated PDFs are stored (default: ./.data)
XTRACT_DATA_DIR=
XTRACT_SUPPORT_EMAIL=
