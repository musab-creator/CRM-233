# =============================================================
# Diversity Roofing — social automation (n8n)
# =============================================================
# Copy to `automation/n8n/.env`. docker-compose reads it and passes
# everything through to n8n, where the workflows reach it as $env.NAME.
#
# Nothing here belongs in git. `.env` is gitignored; `.env.example` is not.
# =============================================================

# ---- n8n itself ----
# The externally reachable base URL. Meta and any other webhook provider
# must be able to POST to this, so localhost will not do — use a tunnel
# (cloudflared, ngrok) in development.
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/New_York
TZ=America/New_York

# Basic auth on the n8n editor. Set both, always.
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=

# 32+ character key n8n uses to encrypt stored credentials at rest.
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# ---- CRM ----
# Where the Next.js app is reachable *from inside the n8n container*.
# On the bundled docker-compose network that is http://host.docker.internal:3000
# on macOS/Windows, or the host IP on Linux.
CRM_BASE_URL=http://host.docker.internal:3000
# Shared secret sent as `x-automation-key`. Must match SOCIAL_AUTOMATION_KEY
# in the CRM's own environment. Also signs the job-completion webhook.
CRM_AUTOMATION_KEY=

# ---- Claude (captions, review replies, triage, weekly readout) ----
# https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---- Meta (Facebook Page + Instagram) ----
# Both networks are one Graph API. The Instagram account must be a
# Business/Creator account linked to the Facebook Page.
META_GRAPH_VERSION=v23.0
META_APP_ID=
META_APP_SECRET=
# Page access token with: pages_manage_posts, pages_read_engagement,
# pages_manage_engagement, instagram_basic, instagram_content_publish,
# instagram_manage_comments, business_management.
# Generate a *System User* token in Business Manager — a normal user token
# expires every 60 days and posting stops silently.
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
# Instagram Business account ID (not the @handle). Leave IG_ACCESS_TOKEN
# blank to reuse the page token, which is the usual setup.
IG_USER_ID=
IG_ACCESS_TOKEN=
# Token you choose; Meta echoes it back during webhook subscription.
META_VERIFY_TOKEN=
# Comma-separated page/IG actor IDs so the lead capture ignores our own
# comments coming back through the webhook.
OWN_ACTOR_IDS=

# ---- Google Business Profile ----
# OAuth client from Google Cloud Console with the Business Profile APIs
# enabled. Scope: https://www.googleapis.com/auth/business.manage
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
# Numeric IDs — the digits only, not the "accounts/" or "locations/" prefix.
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=
# How far back the review workflow looks on each run. Keeps a first run
# against a long review history from replying to everything at once.
REVIEW_LOOKBACK_DAYS=30

# ---- Email ----
# SMTP itself is configured as an n8n credential, not here — only the
# addresses live in env.
ALERT_FROM_EMAIL=automation@diversity-roofing.com
ALERT_EMAIL=musab@diversity-roofing.com
REPORT_EMAIL=musab@diversity-roofing.com
