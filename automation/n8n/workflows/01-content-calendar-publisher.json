        "jsonBody": "={{ JSON.stringify({ model: $('Config').first().json.anthropicModel || 'claude-opus-5', max_tokens: 4000, system: $json.prompt.system, messages: [{ role: 'user', content: $json.prompt.user }], output_config: { effort: 'low', format: { type: 'json_schema', schema: $json.prompt.schema } } }) }}",
