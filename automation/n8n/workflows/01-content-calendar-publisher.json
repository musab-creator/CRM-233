    {
      "parameters": {
        "jsCode": "// One item per (post, platform) pair. If the CRM returns nothing, this node\n// emits zero items and the rest of the workflow is skipped — that is the\n// normal \"no posts due\" path, not an error.\nconst jobs = [];\n\nfor (const item of $input.all()) {\n  for (const job of item.json.jobs ?? []) {\n    jobs.push({\n      json: {\n        postId: job.postId,\n        platform: job.platform,\n        theme: job.theme,\n        targetCity: job.targetCity,\n        media: job.media ?? [],\n        googleCta: job.googleCta ?? null,\n        existingCaption: job.existingCaption,\n        prompt: job.prompt,\n        hasImage: (job.media ?? []).length > 0,\n      },\n    });\n  }\n\n  for (const warning of item.json.warnings ?? []) {\n    console.warn('CRM warning:', warning);\n  }\n}\n\nreturn jobs;"
      },
      "id": "code-expand-jobs",
      "name": "Expand Into Platform Jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        100
      ]
    },
