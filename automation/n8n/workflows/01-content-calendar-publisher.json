    {
      "parameters": {
        "content": "### Facebook\n\nA post with a photo goes to `/{page-id}/photos` (`url` + `caption`). A text-only post goes to `/{page-id}/feed` (`message`).\n\nNeeds a **Page** access token with `pages_manage_posts` and `pages_read_engagement`. Generate a System User token in Business Manager so it does not expire every 60 days.",
        "height": 260,
        "width": 340,
        "color": 5
      },
      "id": "note-facebook",
      "name": "Facebook notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        2520,
        -340
      ]
