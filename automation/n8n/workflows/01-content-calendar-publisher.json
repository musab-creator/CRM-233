        "method": "POST",
        "url": "=https://mybusiness.googleapis.com/v4/accounts/{{ $('Config').first().json.gbpAccountId }}/locations/{{ $('Config').first().json.gbpLocationId }}/localPosts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({ languageCode: 'en-US', summary: $('Route by Platform').item.json.finalCaption, topicType: 'STANDARD' }, ($('Route by Platform').item.json.media || []).length ? { media: [{ mediaFormat: 'PHOTO', sourceUrl: $('Route by Platform').item.json.media[0].url }] } : {}, $('Route by Platform').item.json.googleCta ? { callToAction: Object.assign({ actionType: $('Route by Platform').item.json.googleCta.actionType }, $('Route by Platform').item.json.googleCta.url ? { url: $('Route by Platform').item.json.googleCta.url } : {}) } : {})) }}",
        "options": {
          "timeout": 60000
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleOAuth2Api"
      },
      "id": "http-gbp-publish",
