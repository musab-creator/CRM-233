        "url": "=https://graph.facebook.com/{{ $('Config').first().json.metaGraphVersion || 'v23.0' }}/{{ $('Config').first().json.fbPageId }}/{{ $json.hasImage ? 'photos' : 'feed' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.hasImage ? { url: $json.media[0].url, caption: $json.finalCaption, published: true } : { message: $json.finalCaption }) }}",
        "options": {
