    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Fail closed. Anything that is not an explicit `pass` — a blocked caption, a\n// needs_review caption, a 500 from the CRM, a network timeout — stops here.\n// The cost of a wrong publish is up to $10,000 per violation under\n// Fla. Stat. 489.147; the cost of a missed post is one late post.\nconst job = $('All Captions').item.json;\nconst gate = $json;\n\nconst reachedGate = typeof gate.status === 'string';\nconst status = reachedGate ? gate.status : 'blocked';\n\nconst findings = reachedGate\n  ? (gate.findings ?? [])\n  : [{ code: 'GATE_UNREACHABLE', severity: 'blocker', message: `Compliance endpoint did not answer: ${gate.error?.message ?? gate.message ?? 'unknown error'}` }];\n\nif (job.captionError) {\n  findings.unshift({ code: 'CAPTION_FAILED', severity: 'blocker', message: job.captionError });\n}\n\nconst blockers = findings.filter((f) => f.severity === 'blocker');\nconst reviews = findings.filter((f) => f.severity === 'review');\n\nreturn {\n  json: {\n    ...job,\n    complianceStatus: job.captionError ? 'blocked' : status,\n    finalCaption: gate.caption ?? job.caption,\n    findings,\n    blockerSummary: blockers.map((f) => `${f.code}: ${f.message}`).join(' | '),\n    reviewSummary: reviews.map((f) => `${f.code}: ${f.message}`).join(' | '),\n  },\n};"
      },
      "id": "code-evaluate-gate",
      "name": "Evaluate Gate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2020,
        100
      ]
    },
