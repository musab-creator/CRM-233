    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Every publish branch lands here. Each platform reports success differently,\n// so normalise into the one shape the CRM expects.\nconst res = $json;\nconst platform = $('Route by Platform').item.json.platform;\nconst job = $('Route by Platform').item.json;\n\nlet status = 'failed';\nlet platformPostId;\nlet permalink;\nlet error;\n\nif (res.error) {\n  // Meta returns { error: { message, type, code } }; Google returns\n  // { error: { code, message, status } }. Both are covered by reading .message.\n  error = res.error.message ?? JSON.stringify(res.error);\n} else if (platform === 'facebook' && (res.post_id || res.id)) {\n  status = 'published';\n  platformPostId = res.post_id ?? res.id;\n  permalink = `https://www.facebook.com/${platformPostId}`;\n} else if (platform === 'instagram' && res.id) {\n  status = 'published';\n  platformPostId = res.id;\n} else if (platform === 'google_business' && res.name) {\n  status = 'published';\n  platformPostId = res.name;\n  permalink = res.searchUrl;\n} else {\n  error = `Unrecognised response from ${platform}: ${JSON.stringify(res).slice(0, 400)}`;\n}\n\nreturn {\n  json: {\n    postId: job.postId,\n    platform,\n    status,\n    platformPostId,\n    permalink,\n    error,\n    caption: job.finalCaption,\n  },\n};"
      },
      "id": "code-normalize",
      "name": "Normalise Publish Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
