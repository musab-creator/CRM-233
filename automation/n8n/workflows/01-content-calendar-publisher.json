      "id": "http-compliance",
      "name": "Florida Compliance Gate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1800,
        100
      ],
      "onError": "continueRegularOutput",
      "credentials": {
