    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Structured outputs mean the text block is already valid JSON matching the\n// schema in src/lib/social/prompt.ts — no prose to strip. Two failure modes\n// still need handling: a safety refusal (HTTP 200, stop_reason 'refusal') and\n// a truncated response (stop_reason 'max_tokens').\nconst job = $('Expand Into Platform Jobs').item.json;\nconst res = $json;\n\nfunction fail(reason) {\n  return { json: { ...job, caption: '', captionError: reason } };\n}\n\nif (res.error) {\n  return fail(`Anthropic API error: ${res.error.type ?? 'unknown'} — ${res.error.message ?? ''}`);\n}\n\nif (res.stop_reason === 'refusal') {\n  return fail(`Model declined the request (${res.stop_details?.category ?? 'no category'}).`);\n}\n\nif (res.stop_reason === 'max_tokens') {\n  return fail('Response hit max_tokens and is truncated — raise max_tokens or shorten the brief.');\n}\n\nconst textBlock = (res.content ?? []).find((b) => b.type === 'text');\nif (!textBlock) {\n  return fail('No text block in the model response.');\n}\n\nlet parsed;\ntry {\n  parsed = JSON.parse(textBlock.text);\n} catch (e) {\n  return fail(`Model output was not valid JSON: ${e.message}`);\n}\n\nreturn {\n  json: {\n    ...job,\n    caption: parsed.caption,\n    hook: parsed.hook,\n    modelSaysInsuranceTopic: parsed.mentions_insurance_claim === true,\n    captionError: null,\n    usage: res.usage ?? null,\n  },\n};"
      },
      "id": "code-parse-caption",
      "name": "Parse Caption",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// A human already wrote this caption in the CRM — skip generation entirely.\nreturn {\n  json: {\n    ...$json,\n    caption: $json.existingCaption,\n    hook: String($json.existingCaption).split('\\n')[0],\n    modelSaysInsuranceTopic: false,\n    captionError: null,\n  },\n};"
      },
      "id": "code-use-existing",
      "name": "Use Human-Written Caption",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
