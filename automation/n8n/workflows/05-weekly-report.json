      "parameters": {
        "jsCode": "// Pull the five sources into one flat object. Every source is optional — a\n// broken Google token should still produce a Facebook report, not an error.\nfunction safe(nodeName) {\n  try {\n    const data = $(nodeName).all();\n    return data.length ? data[0].json : null;\n  } catch {\n    return null;\n  }\n}\n\nconst fb = safe('Facebook Insights');\nconst ig = safe('Instagram Insights');\nconst gbp = safe('Google Business Performance');\nconst token = safe('Meta Token Health');\nconst crm = safe('CRM Post History');\n\nfunction metaMetrics(payload) {\n  const out = {};\n  for (const m of payload?.data ?? []) {\n    // Page insights return a values[] series; IG total_value returns a scalar.\n    if (Array.isArray(m.values) && m.values.length) {\n      out[m.name] = m.values.reduce((sum, v) => sum + (typeof v.value === 'number' ? v.value : 0), 0);\n    } else if (m.total_value && typeof m.total_value.value === 'number') {\n      out[m.name] = m.total_value.value;\n    }\n  }\n  return out;\n}\n\nfunction gbpTotals(payload) {\n  const out = {};\n  for (const series of payload?.multiDailyMetricTimeSeries ?? []) {\n    for (const entry of series.dailyMetricTimeSeries ?? []) {\n      const total = (entry.timeSeries?.datedValues ?? []).reduce(\n        (sum, d) => sum + Number(d.value ?? 0),\n        0,\n      );\n      out[entry.dailyMetric] = total;\n    }\n  }\n  return out;\n}\n\n// --- Token expiry\nlet tokenDaysLeft = null;\nlet tokenValid = null;\nconst tokenData = token?.data;\nif (tokenData) {\n  tokenValid = tokenData.is_valid === true;\n  if (tokenData.expires_at === 0) {\n    tokenDaysLeft = Infinity; // System User token — never expires\n  } else if (typeof tokenData.expires_at === 'number') {\n    tokenDaysLeft = Math.floor((tokenData.expires_at * 1000 - Date.now()) / 86400000);\n  }\n}\n\n// --- CRM publishing outcomes over the last 7 days\nconst weekAgo = Date.now() - 7 * 86400000;\nconst history = (crm && Array.isArray(crm.jobs)) ? crm.jobs : [];\n\n// The queue endpoint returns jobs (post x platform). Count distinct posts by id.\nconst byPost = new Map();\nfor (const job of history) {\n  if (!byPost.has(job.postId)) byPost.set(job.postId, job);\n}\n\nconst sources = { facebook: Boolean(fb && !fb.error), instagram: Boolean(ig && !ig.error), google: Boolean(gbp && !gbp.error), crm: Boolean(crm && !crm.error) };\n\nreturn [{\n  json: {\n    weekEnding: new Date().toISOString().slice(0, 10),\n    sources,\n    facebook: metaMetrics(fb),\n    instagram: metaMetrics(ig),\n    googleBusiness: gbpTotals(gbp),\n    token: {\n      valid: tokenValid,\n      daysLeft: tokenDaysLeft === Infinity ? 'never expires' : tokenDaysLeft,\n      needsAttention: tokenValid === false || (typeof tokenDaysLeft === 'number' && tokenDaysLeft < 14),\n    },\n    scheduled: byPost.size,\n    errors: [\n      fb?.error && `Facebook: ${fb.error.message}`,\n      ig?.error && `Instagram: ${ig.error.message}`,\n      gbp?.error && `Google: ${gbp.error.message}`,\n      crm?.error && `CRM: ${crm.error}`,\n    ].filter(Boolean),\n  },\n}];"
      },
