        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $('Config').first().json.anthropicModel || 'claude-opus-5', max_tokens: 3000, system: [ 'You write the Monday social readout for the owner of a roofing company. He reads it on his phone before the first job of the week.', '', 'Lead with what changed and what he should do about it. Then the numbers. Keep the whole thing under 250 words.', 'Write plainly and in full sentences. No headers, no bullet-point soup, no marketing vocabulary, no emoji.', 'Only describe numbers that are actually present in the data. If a source failed, say which one failed in one clause and move on — do not estimate around the gap and do not invent a trend from a single week.', 'If the Meta access token needs attention, that is the first sentence of the email regardless of how the numbers look.' ].join('\\n'), messages: [{ role: 'user', content: `Week ending ${$json.weekEnding}. Here is the raw data:\\n\\n${JSON.stringify($json, null, 2)}` }], output_config: { effort: 'low' } }) }}",
        "options": {
          "timeout": 180000
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi"
      },
      "id": "http-summary",
      "name": "Write the Readout (Claude)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        460
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "anthropicApi": {
          "id": "REPLACE_WITH_ANTHROPIC_CREDENTIAL_ID",
          "name": "DR Anthropic"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Prose from the model, raw numbers appended underneath. If the model call\n// failed the email still goes out with the numbers — the report is the data,\n// the summary is a convenience.\nconst data = $('Assemble Numbers').item.json;\nconst res = $json;\n\nconst textBlock = (res.content ?? []).find((b) => b.type === 'text');\nconst summary = textBlock?.text ?? `(Summary unavailable: ${res.error?.message ?? res.stop_reason ?? 'unknown'}.)`;\n\nfunction table(title, obj) {\n  const rows = Object.entries(obj ?? {});\n  if (!rows.length) return `${title}: no data returned.`;\n  return `${title}\\n` + rows.map(([k, v]) => `  ${k}: ${v}`).join('\\n');\n}\n\nconst body = [\n  summary.trim(),\n  '',\n  '---',\n  '',\n  table('Facebook', data.facebook),\n  '',\n  table('Instagram', data.instagram),\n  '',\n  table('Google Business Profile', data.googleBusiness),\n  '',\n  `Posts tracked in the CRM: ${data.scheduled}`,\n  `Meta token: ${data.token.valid === false ? 'INVALID' : 'valid'}, ${data.token.daysLeft} days left`,\n  data.errors.length ? `\\nSources that failed this run:\\n${data.errors.map((e) => `  - ${e}`).join('\\n')}` : '',\n].join('\\n');\n\nreturn {\n  json: {\n    subject: `${data.token.needsAttention ? '[ACTION NEEDED] ' : ''}Diversity Roofing — social week ending ${data.weekEnding}`,\n    body,\n  },\n};"
      },
