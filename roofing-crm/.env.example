# =============================================================
# StormShield Roofing CRM - Environment Variables
# =============================================================
# Copy this file to `.env.local` (local dev) or add these as
# Secrets in Replit (Tools > Secrets). Never commit real keys.
#
# NOTE: The app runs fully WITHOUT any of these — all API routes
# return realistic mock data until you add real credentials.
# Add them one integration at a time as you go live.
# =============================================================

# ---- CompanyCam (inspection photos) ----
# Get from: CompanyCam > Settings > Integrations > API
COMPANYCAM_API_TOKEN=

# ---- DocuSign (e-signatures for contingencies) ----
# Get from: DocuSign Admin > Apps and Keys
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_USER_ID=
DOCUSIGN_PRIVATE_KEY=
# Use https://demo.docusign.net/restapi for sandbox testing
DOCUSIGN_BASE_URL=https://na3.docusign.net/restapi

# ---- Storm / Hail history lookup ----
# HailTrace: https://hailtrace.com  (paid, address-level history)
HAILTRACE_API_KEY=
# NOAA is free and needs no key, but a token raises rate limits
NOAA_API_TOKEN=

# ---- Email (adjuster follow-ups) ----
# Any SMTP provider works. SendGrid/Mailgun/Google Workspace etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=StormShield Roofing

# ---- SMS (homeowner text follow-ups) ----
# Get from: Twilio Console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---- Google Drive (contingency templates / doc storage) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# ---- Social automation (n8n) ----
# The n8n workflows in automation/n8n/ call this app for the content queue and
# for the Florida compliance gate. See automation/n8n/README.md.
#
# Shared secret n8n sends as `x-automation-key`. Must match CRM_AUTOMATION_KEY
# in automation/n8n/.env. While unset, the /api/social/* routes are open.
SOCIAL_AUTOMATION_KEY=

# Florida contractor license number. FL Admin Code 61G4-12.011 requires it in
# ALL advertising, so the compliance gate blocks every post until this is set.
# This is the single biggest blocker to going live — get it from Musab.
DR_LICENSE_NUMBER=

# Public phone used in captions and checked for by the compliance gate.
DR_PUBLIC_PHONE=(904) 979-0556

# Pipe-separated phrases that are approved company wording and must not trip
# the prohibited-language scan.
DR_APPROVED_PHRASES=We Fight for Your Home So You Don't Have To

# Set to "false" to let posts mentioning insurance claims publish automatically
# once the Fla. Stat. 489.147 disclosures are appended. Default (unset) holds
# them for a human, which is the recommended setting.
SOCIAL_REVIEW_CLAIM_POSTS=

# ---- App config ----
# On Replit this is your repl URL, e.g. https://your-repl.username.repl.co
NEXT_PUBLIC_APP_URL=http://localhost:3000
