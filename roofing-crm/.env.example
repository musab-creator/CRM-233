# =============================================================
# StormShield Roofing CRM - Environment Variables
# =============================================================
# Copy this file to `.env.local` (local dev) or add these as
# Secrets in Replit (Tools > Secrets). Never commit real keys.
#
# NOTE: The app runs fully WITHOUT any of these — all API routes
# return realistic mock data until you add real credentials.
# Add them one integration at a time as you go live.
# =============================================================

# ---- CompanyCam (inspection photos) ----
# Get from: CompanyCam > Settings > Integrations > API
COMPANYCAM_API_TOKEN=

# ---- DocuSign (e-signatures for contingencies) ----
# Get from: DocuSign Admin > Apps and Keys
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_USER_ID=
DOCUSIGN_PRIVATE_KEY=
# Use https://demo.docusign.net/restapi for sandbox testing
DOCUSIGN_BASE_URL=https://na3.docusign.net/restapi

# ---- Storm / Hail history lookup ----
# HailTrace: https://hailtrace.com  (paid, address-level history)
HAILTRACE_API_KEY=
# NOAA is free and needs no key, but a token raises rate limits
NOAA_API_TOKEN=

# ---- Email (adjuster follow-ups) ----
# Any SMTP provider works. SendGrid/Mailgun/Google Workspace etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=StormShield Roofing

# ---- SMS (homeowner text follow-ups) ----
# Get from: Twilio Console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---- Google Drive (contingency templates / doc storage) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# ---- App config ----
# On Replit this is your repl URL, e.g. https://your-repl.username.repl.co
NEXT_PUBLIC_APP_URL=http://localhost:3000
