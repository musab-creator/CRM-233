# meme-agents-claude configuration. Copy to .env and fill in. Never commit .env.
# Every variable the bot reads is listed here; defaults are shown.

# ---- mode ---------------------------------------------------------------------------
MODE=paper                       # paper | live
LIVE_CONFIRM=                    # live mode requires exactly: I_ACCEPT_LOSSES
LIVE_DRY_RUN=true                # live mode builds, signs and simulates transactions but never sends them;
                                 # only an explicit false/0/no/off disables it, anything unrecognised refuses to start
LIVE_MAX_WALLET_SOL=0.5          # live refuses to start if the wallet holds more than this

# ---- secrets ------------------------------------------------------------------------
# KEYS.md explains where to get each key. Required: ANTHROPIC_API_KEY, HELIUS_API_KEY.
ANTHROPIC_API_KEY=
HELIUS_API_KEY=                  # free plan is enough: curves, holders, launch trades are read through it
X_BEARER_TOKEN=                  # X API v2 pay-per-use app bearer token (optional; Scout/Hunter degrade without it)
PUMPPORTAL_API_KEY=              # NOT needed: only for the optional paid trade stream (see PUMPPORTAL_TRADE_STREAM)
JUPITER_API_KEY=                 # free key from portal.jup.ag (optional; graduated tokens in live mode)
CRYPTOPANIC_TOKEN=               # optional and paid since 2026; free RSS feeds are used without it
TELEGRAM_BOT_TOKEN=              # optional alerts
TELEGRAM_CHAT_ID=
WALLET_PRIVATE_KEY=              # live mode only: base58 secret key or JSON byte array

# ---- paths --------------------------------------------------------------------------
DB_PATH=data/bot.db
REPORTS_DIR=reports
STOP_FILE=STOP                   # kill switch: create this file to stop entries and close all positions
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log            # rotated at 20 MB, 5 files kept; empty = console only

# ---- endpoints ----------------------------------------------------------------------
PUMPPORTAL_WS=wss://pumpportal.fun/api/data
PUMPPORTAL_TRADE_URL=https://pumpportal.fun/api/trade-local
DEXSCREENER_URL=https://api.dexscreener.com
RUGCHECK_URL=https://api.rugcheck.xyz/v1
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key={key}
HELIUS_API_URL=https://api-mainnet.helius-rpc.com/v0
JUPITER_URL=https://api.jup.ag/swap/v2
X_API_URL=https://api.x.com/2
CRYPTOPANIC_URL=https://cryptopanic.com/api/developer/v2/posts/
NEWS_RSS_URLS=https://cointelegraph.com/rss,https://www.coindesk.com/arc/outboundfeeds/rss/
TRUTH_SOCIAL_RSS_URL=            # RSS mirror of @realDonaldTrump on Truth Social, if you have one

# ---- bankroll & risk ----------------------------------------------------------------
BANKROLL_USD=50
MAX_OPEN_POSITIONS=3
MAX_POSITIONS_PER_CREATOR=1
POSITION_MIN_USD=5
POSITION_MAX_USD=10
DAILY_LOSS_CAP_PCT=50            # of bankroll; pauses entries until restart

# ---- pre-filter ---------------------------------------------------------------------
PF_MIN_AGE_MIN=5
PF_MAX_AGE_MIN=90
PF_MIN_UNIQUE_BUYERS=40
PF_MIN_NET_INFLOW_SOL=15
PF_MAX_TOP10_PCT=35
PF_MIN_LIQUIDITY_USD=8000
PF_REQUIRE_NULL_AUTHORITIES=true
PF_CURVE_LIQUIDITY_FALLBACK=true  # DexScreener reports no liquidity for bonding-curve pairs: use 2 x the curve's
                                  # real SOL reserve x SOL/USD instead (false = only graduated tokens can pass)
PF_SCAN_INTERVAL_S=20

# ---- consensus ----------------------------------------------------------------------
CONSENSUS_MIN_MEAN_CONFIDENCE=0.65

# ---- paper cost model ---------------------------------------------------------------
PUMPFUN_FEE_PCT=1.0
PUMPPORTAL_FEE_PCT=0.5
NETWORK_FEE_SOL=0.005
ENTRY_SLIPPAGE_PCT=3
EXIT_SLIPPAGE_PCT=5
ENTRY_FILL_TIMEOUT_S=300         # cancel an entry if no trade arrives after the decision
EXIT_FILL_TIMEOUT_S=120          # non-tick exits fill at last price after this
EXIT_RETRY_BASE_S=5              # a failed exit retries after 5s, 10s, 20s ... (exponential backoff)
EXIT_RETRY_MAX_S=300             # ... capped at this interval; it keeps retrying and alerts
LIVE_CONFIRM_TIMEOUT_S=60        # live sends: wait this long for confirmation before reconciling by balance

# ---- exits --------------------------------------------------------------------------
STOP_LOSS_PCT=40
TAKE_PROFIT_PCT=60
TAKE_PROFIT_SELL_FRACTION=0.5
TRAILING_STOP_PCT=30
TIME_STOP_HOURS=6
EMERGENCY_LIQ_DROP_PCT=50
LIQ_POLL_S=60
RUGCHECK_POLL_S=300

# ---- data sources -------------------------------------------------------------------
# PumpPortal streams per-token trades only to funded API keys (0.01 SOL per 10,000 trades)
# since May 2026. off = read token state from the chain via Helius (default, free);
# positions = also stream candidates and open positions; all = stream every launch (~1 SOL/day).
PUMPPORTAL_TRADE_STREAM=off
PUMPPORTAL_DAILY_BUDGET_SOL=0.01 # streaming stops for the UTC day at this spend
PUMPPORTAL_SOL_PER_TRADE=0.000001
HELIUS_MONTHLY_CREDITS=1000000   # free plan; curve reads slow down if usage runs ahead of pace
                                 # paid Developer plan: 10000000 here, HELIUS_RPC_RPS=50, HELIUS_ENHANCED_RPS=10 (KEYS.md)
CURVE_POLL_CALLS_PER_MIN=8       # getMultipleAccounts calls per minute (100 curves, 1 credit each)
CURVE_HOT_POLL_S=15              # candidates, open positions and shadows are read this often
CURVE_FIRST_POLL_S=60            # first read of a launch
CURVE_POLL_SCALE=1.0             # multiplies the 20/45/120/240 s cadence of tracked launches
CURVE_DROP_AFTER_MIN=15          # stop following a launch this old ...
CURVE_DROP_BELOW_SOL=1.0         # ... that has taken in less SOL than this
HOLDERS_REFRESH_S=300            # holder count (DAS, 10 credits) at most this often per token ...
HOLDER_CHECKS_PER_SCAN=4         # ... and at most this many per pre-filter scan (every PF_SCAN_INTERVAL_S)
BACKFILL_WINDOW_S=60             # a candidate's launch-minute trades are rebuilt from chain ...
BACKFILL_MAX_TX=80               # ... reading at most this many transactions

# ---- ingest -------------------------------------------------------------------------
MAX_TRACKED_MINTS=3000
TRADE_RETENTION_HOURS=48
WS_MAX_BACKOFF_S=60
WS_STALL_S=90                    # reconnect if the stream is silent this long

# ---- LLM ----------------------------------------------------------------------------
LLM_MODEL=claude-sonnet-4-6
LLM_DAILY_BUDGET_USD=5
LLM_BUDGET_PACING=true           # spread the daily budget over the UTC day (a live hour cost $2.26: unpaced, $5
                                 # is gone by 02:30 UTC and the bot evaluates nothing until midnight)
LLM_BUDGET_BURST_HOURS=2         # hours' worth available up front: $0.42 at midnight with a $5 budget, then +$0.21/h
LLM_PRICE_IN_PER_MTOK=3
LLM_PRICE_OUT_PER_MTOK=15
LLM_MAX_TURNS=6
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_S=120
LLM_CONCURRENCY=2                # candidates evaluated in parallel (3 agents each)
AGENT_MIN_GROUNDING=0.5          # a BUY needs >=1 successful tool call and this share of evidence found in tool data

# ---- X API --------------------------------------------------------------------------
X_MONTHLY_BUDGET_USD=20
X_POST_READ_USD=0.005
X_USER_READ_USD=0.01
X_SEARCH_MAX_RESULTS=10
X_TIMELINE_MAX_RESULTS=5
X_TIMELINE_REFRESH_MIN=10
WATCHLIST_HANDLES=elonmusk,realDonaldTrump
CATALYST_WINDOW_MIN=60
NEWS_REFRESH_MIN=5

# ---- rate limits (requests per second) ----------------------------------------------
DEX_TOKENS_RPS=5
DEX_BOOSTS_RPS=1
RUGCHECK_RPS=2
HELIUS_RPC_RPS=10
HELIUS_ENHANCED_RPS=2
JUPITER_RPS=1
