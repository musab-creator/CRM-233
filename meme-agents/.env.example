# meme-agents-claude configuration. Copy to .env and fill in. Never commit .env.
# Every variable the bot reads is listed here; defaults are shown.

# ---- mode ---------------------------------------------------------------------------
MODE=paper                       # paper | live
LIVE_CONFIRM=                    # live mode requires exactly: I_ACCEPT_LOSSES
LIVE_DRY_RUN=true                # live mode builds, signs and simulates transactions but never sends them;
                                 # only an explicit false/0/no/off disables it, anything unrecognised refuses to start
LIVE_MAX_WALLET_SOL=0.5          # live refuses to start if the wallet holds more than this (at most 3)
LIVE_ACCOUNT_RENT_SOL=0.0025     # a buy may take this much beyond amount + fees: rent for the wallet's new token account

# ---- secrets ------------------------------------------------------------------------
# KEYS.md explains where to get each key. Required: ANTHROPIC_API_KEY, HELIUS_API_KEY.
ANTHROPIC_API_KEY=
HELIUS_API_KEY=                  # free plan is enough: curves, holders, launch trades are read through it
X_BEARER_TOKEN=                  # X API v2 pay-per-use app bearer token (optional; Scout/Hunter degrade without it)
PUMPPORTAL_API_KEY=              # NOT needed: only for the optional paid trade stream (see PUMPPORTAL_TRADE_STREAM)
JUPITER_API_KEY=                 # free key from portal.jup.ag (optional; graduated tokens in live mode)
CRYPTOPANIC_TOKEN=               # optional and paid since 2026; free RSS feeds are used without it
TELEGRAM_BOT_TOKEN=              # optional alerts
TELEGRAM_CHAT_ID=
TELEGRAM_DIGEST=all              # hourly Telegram digest of trades: all | wins (only hours with a winning trade) | off
TELEGRAM_COMMANDS=true           # answer /status /digest /report /stop /resume (and /update /restart /set via the ops service) from TELEGRAM_CHAT_ID
WALLET_PRIVATE_KEY=              # live mode only: base58 secret key or JSON byte array

# ---- paths --------------------------------------------------------------------------
DB_PATH=data/bot.db
REPORTS_DIR=reports
STOP_FILE=STOP                   # kill switch: create this file to stop entries and close all positions
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log            # rotated at 20 MB, 5 files kept; empty = console only

# ---- endpoints ----------------------------------------------------------------------
PUMPPORTAL_WS=wss://pumpportal.fun/api/data
PUMPPORTAL_TRADE_URL=https://pumpportal.fun/api/trade-local
DEXSCREENER_URL=https://api.dexscreener.com
SOL_USD_FALLBACK_URL=https://api.coingecko.com/api/v3/simple/price?ids=solana&vs_currencies=usd  # when DexScreener has no SOL pair
RUGCHECK_URL=https://api.rugcheck.xyz/v1
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key={key}
HELIUS_API_URL=https://api-mainnet.helius-rpc.com/v0
HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key={key}   # insider watch: transactionSubscribe stream
JUPITER_URL=https://api.jup.ag/swap/v2
X_API_URL=https://api.x.com/2
CRYPTOPANIC_URL=https://cryptopanic.com/api/developer/v2/posts/
NEWS_RSS_URLS=https://cointelegraph.com/rss,https://www.coindesk.com/arc/outboundfeeds/rss/
TRUTH_SOCIAL_RSS_URL=            # RSS mirror of @realDonaldTrump on Truth Social, if you have one

# ---- bankroll & risk ----------------------------------------------------------------
BANKROLL_USD=50                 # phone: 1-500; the daily loss cap is DAILY_LOSS_CAP_PCT of this. Live, the wallet
                                # (at most LIVE_MAX_WALLET_SOL at startup) is what a buy can spend
MAX_OPEN_POSITIONS=3            # phone: 1-20; live, the wallet also keeps one sale's fee per open position
MAX_POSITIONS_PER_CREATOR=1
POSITION_MIN_USD=5
POSITION_MAX_USD=10
DAILY_LOSS_CAP_PCT=50            # of bankroll; pauses entries until restart

# ---- pre-filter ---------------------------------------------------------------------
PF_MIN_AGE_MIN=5
PF_MAX_AGE_MIN=90
PF_MIN_UNIQUE_BUYERS=40
PF_MIN_NET_INFLOW_SOL=15
PF_MAX_TOP10_PCT=35
PF_MIN_LIQUIDITY_USD=8000
PF_REQUIRE_NULL_AUTHORITIES=true
PF_CURVE_LIQUIDITY_FALLBACK=true  # DexScreener reports no liquidity for bonding-curve pairs (or no pair during its
                                  # outages): use 2 x the curve's real SOL reserve x SOL/USD instead for tokens still
                                  # on the curve (false = only graduated tokens can pass)
PF_SCAN_INTERVAL_S=20

# ---- consensus ----------------------------------------------------------------------
CONSENSUS_MIN_MEAN_CONFIDENCE=0.65
GATE_NEUTRAL_VOTES=true          # Scout and Hunter vote the neutral BUY when they find nothing against a token; false = strict prompts (PASS unless attention / catalyst found)
# The neutral vote. With the 0.65 floor it sets the Analyst's bar (3 x floor - 2 x this): 0.625 -> the Analyst
# needs 0.70; 0.6 -> 0.75 (the old arithmetic). Between 0.5 and 0.65, never above the floor.
NEUTRAL_VOTE_CONFIDENCE=0.625

# ---- paper cost model ---------------------------------------------------------------
PUMPFUN_FEE_PCT=1.0
PUMPPORTAL_FEE_PCT=0.5
NETWORK_FEE_SOL=0.005           # the most one transaction may cost; the spend checks allow this much
# Priority fee sent with each PumpPortal transaction (Jupiter sets its own). Buys and planned sells
# (take-profit, trailing and time stops, the runner's target) pay PRIORITY_FEE_SOL; a stop loss, an
# emergency, the kill switch and any retried sale pay URGENT_PRIORITY_FEE_SOL to land fast. The paper
# and shadow books charge the same. PRIORITY <= URGENT <= 80% of NETWORK_FEE_SOL. Phone: /set, within
# 0.0001-0.004 and 0.0005-0.004.
PRIORITY_FEE_SOL=0.001
URGENT_PRIORITY_FEE_SOL=0.004
ENTRY_SLIPPAGE_PCT=3
EXIT_SLIPPAGE_PCT=5
ENTRY_FILL_TIMEOUT_S=300         # cancel an entry if no trade arrives after the decision
# a refused live buy is retried on later ticks, this many attempts in all
LIVE_ENTRY_ATTEMPTS=3
EXIT_FILL_TIMEOUT_S=120          # non-tick exits fill at last price after this
EXIT_RETRY_BASE_S=5              # a failed exit retries after 5s, 10s, 20s ... (exponential backoff)
EXIT_RETRY_MAX_S=300             # ... capped at this interval; it keeps retrying and alerts
LIVE_CONFIRM_TIMEOUT_S=60        # live sends: wait this long for confirmation before reconciling by balance

# ---- exits --------------------------------------------------------------------------
STOP_LOSS_PCT=30                 # 11 Oct: the coins that doubled never dipped below -20% first; -40% filled near -47%
TAKE_PROFIT_PCT=60
TAKE_PROFIT_SELL_FRACTION=0.5
TRAILING_STOP_PCT=30
# The trailing stop also runs before the take-profit once the price has been this far above the entry:
# a coin that ran +30% and gives it back sells 30% under its peak (early_trailing_stop), not at the stop
# loss. 0 = only after the take-profit. Must stay below TAKE_PROFIT_PCT.
TRAILING_ARM_PCT=30
TIME_STOP_HOURS=6
# Runner (off by default; phone: /set RUNNER_ENABLED=true). After a take-profit, the core's trailing
# or time stop sells all but RUNNER_FRACTION of the original tokens, but only while the sales so far
# plus that one cover the entry cost (checked again on the real receipt). The runner then exits at
# RUNNER_TARGET_MULTIPLE x the entry price, after RUNNER_MAX_HOLD_HOURS from entry or on an emergency
# (and at the stop loss only with RUNNER_STOP_LOSS=true); it has no trailing stop and does not take
# one of the MAX_OPEN_POSITIONS slots.
# Each position keeps the settings it was opened with, except RUNNER_STOP_LOSS, read at every price.
RUNNER_ENABLED=false
RUNNER_FRACTION=0.10             # of the original tokens (0.01-0.25)
RUNNER_TARGET_MULTIPLE=300       # the price as a multiple of the entry price, not the position's return
RUNNER_MAX_HOLD_HOURS=168        # from the entry; must exceed TIME_STOP_HOURS
RUNNER_STOP_LOSS=false           # the runner's cost is covered: a dip below entry does not sell it (applies to open runners too)
EMERGENCY_LIQ_DROP_PCT=50            # measured from the buy: the curve's depth, then its PumpSwap pool after graduation
ENTRY_MAX_LIQ_SLIP_PCT=20            # refuse a real buy whose curve depth fell more than this since the scan (0 = off)
LIQ_POLL_S=60
# a price more than this many times away from the last mark waits for a second tick (0 = off)
TICK_SANITY_FACTOR=20
RUGCHECK_POLL_S=300
# Moonshot tracker (measures only, never trades): every evaluated coin is read on DexScreener for
# MOONSHOT_TRACK_DAYS from the price its shadow opened at; /moonshots and the report show which ones
# went 10x/100x/500x and whether the bot bought, passed, vetoed or skipped them at triage.
MOONSHOT_TRACK_DAYS=14           # 0 turns it off; at most 60
MOONSHOT_POLL_MIN=15             # coins older than a day are read every 4th pass
MOONSHOT_ALERT_MULTIPLE=100      # one Telegram note when a coin's confirmed peak reaches this; 0 = off (phone: 0-10000)

# ---- data sources -------------------------------------------------------------------
# PumpPortal streams per-token trades only to funded API keys (0.01 SOL per 10,000 trades)
# since May 2026. off = read token state from the chain via Helius (default, free);
# positions = also stream candidates and open positions; all = stream every launch (~1 SOL/day).
PUMPPORTAL_TRADE_STREAM=off
PUMPPORTAL_DAILY_BUDGET_SOL=0.01 # streaming stops for the UTC day at this spend
PUMPPORTAL_SOL_PER_TRADE=0.000001
HELIUS_MONTHLY_CREDITS=1000000   # free plan; curve reads slow down if usage runs ahead of pace
                                 # paid Developer plan: 10000000 here, HELIUS_RPC_RPS=50, HELIUS_ENHANCED_RPS=10 (KEYS.md)
CURVE_POLL_CALLS_PER_MIN=8       # getMultipleAccounts calls per minute (100 curves, 1 credit each; phone: 1-60)
CURVE_HOT_POLL_S=15              # candidates, open positions and shadows are read this often (phone: 3-60)
POSITION_POLL_S=2                # real positions' curves on their own loop, 1 credit a read (phone: 0-15, 0 = off)
POSITION_DEX_POLL_S=10           # graduated real positions: DexScreener's pool price this often (phone: 0-120)
# Insider sales on held coins: every trade on the curve of each open position (real ones first, then the
# newest shadows, at most INSIDER_WATCH_MAX coins) is streamed from Helius, and each trade by the coin's
# creator, launch-minute buyers, snipers, bundle wallets or top holders after the buy is recorded. What
# counts is their net selling since the buy, wallet by wallet: sales minus buy-backs.
# INSIDER_EXIT=false only records: /report shows what selling at the warning would have returned.
# true sells as an emergency once the insiders' net sales since the buy reach INSIDER_EXIT_SUPPLY_PCT of
# the supply (a runner keeps riding). Streaming costs 1 Helius credit per connection and 2 per 0.1 MB
# received; both count toward HELIUS_MONTHLY_CREDITS. Only real positions are streamed while spending
# runs ahead of that budget, and nothing while it is spent.
INSIDER_WATCH=true               # phone: true/false
INSIDER_EXIT=false               # phone: true/false
INSIDER_EXIT_SUPPLY_PCT=2        # % of the supply sold by insiders since the buy (phone: 0.5-20)
INSIDER_WATCH_MAX=60             # coins streamed at once (phone: 1-200)
# Wallet memory: each candidate's launch-minute buyers and creator, scored on the coins the bot evaluated
# before it (earlier launches by the creator, buyers seen in 2+ or 10+ earlier launches, buyers whose
# earlier coins reached 2x half the time). Stored with each candidate and measured in /report; the agents
# do not see these numbers yet. Coins from the last 14 days without launch buyers on record are read
# back from the chain (about 1 credit per transaction, up to BACKFILL_MAX_TX per coin, 3 reads at a time).
LAUNCH_MEMORY_DAYS=7             # days of coins the memory covers (phone: 0-14 whole days, 0 = off)
LAUNCH_BACKFILL_PER_MIN=10       # past coins read back a minute, newest first, only while Helius spending is under
                                 # 80% of the month's pace with 5% of the month left (phone: 0-60)
CURVE_FIRST_POLL_S=60            # first read of a launch
CURVE_POLL_SCALE=1.0             # multiplies the 20/45/120/240 s cadence of tracked launches
CURVE_DROP_AFTER_MIN=15          # stop following a launch this old ...
CURVE_DROP_BELOW_SOL=1.0         # ... that has taken in less SOL than this
HOLDERS_REFRESH_S=300            # holder count (DAS, 10 credits) at most this often per token ...
HOLDER_CHECKS_PER_SCAN=4         # ... and at most this many per pre-filter scan (every PF_SCAN_INTERVAL_S)
BACKFILL_WINDOW_S=60             # a candidate's launch-minute trades are rebuilt from chain ...
BACKFILL_MAX_TX=80               # ... reading at most this many transactions

# ---- ingest -------------------------------------------------------------------------
MAX_TRACKED_MINTS=3000
TRADE_RETENTION_HOURS=48
WS_MAX_BACKOFF_S=60
WS_STALL_S=90                    # reconnect if the stream is silent this long

# ---- LLM ----------------------------------------------------------------------------
LLM_MODEL=claude-sonnet-4-6
LLM_DAILY_BUDGET_USD=5           # phone: 0-150; enforced in code: no candidate is evaluated past it
LLM_BUDGET_PACING=true           # spread the daily budget over the UTC day (a live hour cost $2.26: unpaced, $5
                                 # is gone by 02:30 UTC and the bot evaluates nothing until midnight)
LLM_BUDGET_BURST_HOURS=2         # hours' worth available up front: $0.42 at midnight with a $5 budget, then +$0.21/h
LLM_PRICE_IN_PER_MTOK=3
LLM_PRICE_OUT_PER_MTOK=15
LLM_MAX_TURNS=6
LLM_MAX_TOKENS=2048
# Maximum serialized request bytes; oversized requests are refused before billing.
LLM_MAX_INPUT_BYTES=120000
LLM_TIMEOUT_S=120
LLM_CONCURRENCY=2                # candidates evaluated in parallel (3 agents each)
AGENT_MIN_GROUNDING=0.5          # a BUY needs >=1 successful tool call and this share of evidence found in tool data
TRIAGE_ENABLED=true              # cheap first screen: a Haiku call (~$0.005) decides whether the three agents run
TRIAGE_MODEL=claude-haiku-4-5
TRIAGE_PRICE_IN_PER_MTOK=1
TRIAGE_PRICE_OUT_PER_MTOK=5
TRIAGE_MAX_TOKENS=600
TRIAGE_MIN_CONFIDENCE=0.7        # triage may skip a candidate only when this sure; otherwise the agents decide
VETO_ENABLED=true                # after a unanimous BUY, two veto agents (wallet forensics, social graph) can still block
VETO_MIN_CONFIDENCE=0.7          # a veto needs this confidence and evidence from its own tool results
FORENSICS_HOLDER_WALLETS=8       # top holders whose funding is traced through Helius (100 credits per wallet)
SOCIAL_MAX_AUTHORS=10            # X author profiles looked up per candidate ($0.01 each)
REGIME_ENABLED=true              # market regime agent: every 15 min reads SOL trend, launch rate, shadow-book results
REGIME_MODEL=claude-haiku-4-5    #   and sets normal / cautious (smaller entries) / off (no new entries)
REGIME_REFRESH_MIN=15
REGIME_MIN_MULTIPLIER=0.25

# ---- X API --------------------------------------------------------------------------
X_MONTHLY_BUDGET_USD=20
X_POST_READ_USD=0.005
X_USER_READ_USD=0.01
X_SEARCH_MAX_RESULTS=10
X_TIMELINE_MAX_RESULTS=5
X_TIMELINE_REFRESH_MIN=10
WATCHLIST_HANDLES=elonmusk,realDonaldTrump
CATALYST_WINDOW_MIN=60
NEWS_REFRESH_MIN=5

# ---- rate limits (requests per second) ----------------------------------------------
DEX_TOKENS_RPS=5
DEX_BOOSTS_RPS=1
RUGCHECK_RPS=2
HELIUS_RPC_RPS=10
HELIUS_ENHANCED_RPS=2
JUPITER_RPS=1
